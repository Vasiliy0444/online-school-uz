Rpb25fcyI6MzgsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&_nc_gid=FCSl5jFwrGlVQxx1J6_UpQ&_nc_ss=7b289&_nc_zt=28&oh=00_AQKGJwO239zHUFgBr8p0QkPtFncn3s-IQ9_BFScdl2tDwA&oe=6AB096B1", "watermarked_video_hd_url": null, "watermarked_video_sd_url": null}], "is_reshared": false, "extra_links": ["https://youtu.be/3PcqDTxEWCI", "https://uranus.uz/o-nas/", "https://youtu.be/3PcqDTxEWCI"], "extra_texts": [{"text": "Nima uchun treyding hozircha barqaror natija bermayapti?"}, {"text": "1 daqiqada 7 ta oddiy savolga javob bering va treydingda o‘zingiz istagan natijalarga erishishga yordam beradigan yechim haqida bilib oling.\n\n7 ta savol (1 daqiqa vaqtingiz)\n\nOxirida birjadagi savdolaringizni yaxshilash uchun qanday birinchi qadam qo‘yish kerakligini bilib olasiz.\n\nBepul va anonim, javoblaringizni hech kim ko‘rmaydi"}, {"text": "Iltimos, siz bilan bog’lanishimiz uchun faol telefon raqamingizni qoldiriing"}, {"text": "Hozir nima bilan shug‘ullanyapsiz?"}, {"text": "Yollanma ishchiman"}, {"text": "Savdo-sotiq"}, {"text": "Chet elda ishlayman"}, {"text": "O‘qiyman"}, {"text": "Hozir bozordagi savdongiz qanday ko‘rinishda?"}, {"text": "Bozorni kuzatib boryapman, lekin haqiqiy bitimlar kam bo‘ldi."}, {"text": "O‘zim savdo qilyapman, lekin natija barqaror emas, goh ijobiy, goh salbiy"}, {"text": "Asosan boshqalarning ishoralari va maslahatlari asosida harakat qilaman."}, {"text": "Tizimli tahlilsiz, narxlar farqidan qo‘lda daromad topaman"}, {"text": "Hozir siz uchun eng muhimi nima?"}, {"text": "Har oyda barqaror natija"}, {"text": "Signallar uchun to‘lovni to‘xtatib, mustaqil savdo qilish"}, {"text": "Asosiy ish yoki biznesdan tashqari ikkinchi daromad manbai"}, {"text": "To‘plangan narsalarni saqlash va ko‘paytirish"}, {"text": "Bir oyda qancha summa siz uchun yaxshi qo‘shimcha bo‘ladi?"}, {"text": "500$ gacha"}, {"text": "$500–1500"}, {"text": "$1500–3000"}, {"text": "3000$ dan ortiq"}, {"text": "Hozir treydingdan xohlaganingizcha daromad olishingizga nima to‘sqinlik qilmoqda?"}, {"text": "O‘z tizimim yo‘q - kirishni ko‘ryapman, ammo natijani saqlab qololmayapman."}, {"text": "Boshqalarning signallari va maslahatlariga bog‘liqman, o‘zim qaror qabul qila olmayman."}, {"text": "Bitim tavakkalchiligini hisobga olmayapman - rejalashtirganimdan ko‘ra ko‘proq yo‘qotyapman"}, {"text": "Tizimli ravishda savdo qilish va tushunishga vaqt yetishmaydi"}, {"text": "Treydingni o‘rganishda sizda nima shubha uyg‘otadi?"}, {"text": "Allaqachon treningdan o‘tganman, lekin natija ololmadim, hammasi takrorlanishidan qo‘rqaman."}, {"text": "O‘qishga vaqtim yetmay qolsa-chi?"}, {"text": "To‘satdan yangi hech narsa bilmay, shunchaki vaqtim va pulimni behuda sarflab qo‘ysam-chi?"}, {"text": "Guruh darajasini oshirib yuborishdan qo‘rqaman, balki men o‘ylaganimdek tajribali emasdirman."}, {"text": "Hech narsadan xijolat bo‘lmayman — boshlashga tayyorman"}, {"text": "O‘qishga qancha vaqt ajratishga tayyorsiz?"}, {"text": "Kuniga 30 daqiqagacha"}, {"text": "Kuniga 1 soat"}, {"text": "Kuniga 1 soatdan ortiq"}, {"text": "Faqat dam olish kunlari"}, {"text": "Ismingiz nima?"}, {"text": "Telegramda siz bilan bog‘lanishimiz uchun profilingizni yozing"}, {"text": "Iltimos, aloqa uchun joriy kontaktingizni qoldiring"}, {"text": "Phone number"}, {"text": "Terms and Conditions for Uranus"}, {"text": "Visit Uranus's Privacy Policy"}, {"text": "Rahmat, arizangiz qabul qilindi"}, {"text": "Bizning kurslarimizga qiziqish bildirganingiz uchun rahmat.\n\nKursimiz orqali treydingdagi  bilim va ko‘nikmalaringizni keyingi bosqichga olib chiqmoqchi bo‘lsangiz va kurs haqida barcha savollaringizga aniq javob olishni istasangiz, pastdagi havola orqali to‘liq ma’lumot olishingiz mumkin"}], "extra_images": [], "extra_videos": [], "country_iso_code": null, "brazil_tax_id": null, "additional_info": null, "ec_certificates": []}, "has_user_reported": false, "report_count": null, "menu_items": [], "state_media_run_label": null, "page_name": "Uranus", "impressions_with_index": {"impressions_tex