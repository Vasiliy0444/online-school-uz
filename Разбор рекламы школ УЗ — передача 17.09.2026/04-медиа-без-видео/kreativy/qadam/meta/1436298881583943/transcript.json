   "end": 25.94,
   "text": "Pul tapish uchun, ishtash kereyli gini hamayan biladi."
  },
  {
   "start": 26.24,
   "end": 29.1,
   "text": "Lekin, er talibten kechkeche, uyni, rozgarini,"
  },
  {
   "start": 29.1,
   "end": 31.98,
   "text": "qazan tovanin tashab getishkin xamayan tayar imas."
  },
  {
   "start": 32.38,
   "end": 34.04,
   "text": "Farzan tarbiyasini tashab koymastan,"
