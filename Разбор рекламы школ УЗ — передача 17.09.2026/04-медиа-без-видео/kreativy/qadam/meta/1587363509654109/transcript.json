 "segments": [
  {
   "start": 0.0,
   "end": 2.7,
   "text": "Pul topsh uchun ishtashkiri iligini hamayam biladi."
  },
  {
   "start": 2.7,
   "end": 5.76,
   "text": "Lekin, iyer talibdan kechkechi uyni, rozgarini,"
  },
  {
   "start": 5.76,
   "end": 8.86,
   "text": "qozontavani, tashab ketchishki hamayam tayyar imas."
  },
  {
   "start": 8.86,
   "end": 12.12,
   "text": "Khazir bunaki imkonyatladan bittasi uzun markid ikan."
  },
  {
   "start": 12.8,
   "end": 15.88,
   "text": "Mana uydu otri, beye malol onlayn savdogilishmukun."
  },
  {
   "start": 15.88,
   "end": 18.76,
   "text": "Maksulo tan liysiz, uzumgi cay liysiz,"
  },
  {
   "start": 18.76,
   "end": 20.76,
   "text": "qolganini platformani ozu qiladi."
  },
  {
   "start": 21.16,
   "end": 24.42,
   "text": "Shun arslan organishta, sizgi qadam edikishini yordam biradi."
  },
  {
   "start": 24.42,
   "end": 27.38,
   "text": "Mangi in yokgani sod datildi qadam ma qadan"
  },
  {
   "start": 27.38,
   "end": 29.48,
   "text": "dan sizde nol dan daramat gechi ap chikishadi."
  },
  {
   "start": 29.62,
   "end": 31.92,
   "text": "Agar vloyotdan turub, okumakchi bolsangiz,"
  },
  {
   "start": 32.06,
   "end": 33.72,
   "text": "onlayn platformada organichingiz mumkun."
  },
  {
   "start": 33.92,
   "end": 35.26,
   "text": "Agar toshkende yashishangiz,"
  },
  {
   "start": 35.6,
   "end": 38.58,
   "text": "shundo kasmanatlar metro yonada okub markez joylashgan,"
  },
  {
   "start": 38.9,
   "end": 41.36,
   "text": "gelib offlayn tarsladda ishirokichingiz mumkun."
  }
 ],
