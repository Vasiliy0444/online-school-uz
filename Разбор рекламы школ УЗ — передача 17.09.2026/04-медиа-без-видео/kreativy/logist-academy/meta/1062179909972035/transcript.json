   "text": "Uqish xafta ichida, updaterlikke ishka kirk kirtim."
  },
  {
   "start": 2.76,
   "end": 4.42,
   "text": "Assalamu alaykum, ma'ru salat."
  },
  {
   "start": 4.74,
   "end": 7.92,
   "text": "Qorazimna, Logist Akademika Logistikyan organishchun kigyanman."
  },
  {
   "start": 8.3,
   "end": 11.96,
   "text": "Bura ali kurski yazilib, uqish xafta ichida, updaterlikke ishka kirk kirtim."
  },
  {
   "start": 12.28,
   "end": 14.42,
   "text": "Ikiyganimda, speaking darajam pastadi,"
  },
  {
   "start": 14.96,
   "end": 17.1,
   "text": "ki uqish xafta ichida, speakingimniyam kotarib,"
  },
  {
   "start": 17.16,
   "end": 19.14,
   "text": "logistika kurslariniyam odlashdirbardim."
  },
  {
   "start": 19.52,
   "end": 21.94,
   "text": "Bugun da, isma ulitichin yordamlarik etta."
  },
  {
   "start": 22.5,
   "end": 23.66,
   "text": "Etta rahmat etukolaman."
  },
  {
   "start": 24.34,
   "end": 25.96,
   "text": "Xamaga Logist Akademika tasyaqlami."
  }
