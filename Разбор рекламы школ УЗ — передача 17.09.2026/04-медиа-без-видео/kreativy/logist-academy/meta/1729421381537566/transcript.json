  {
   "start": 0.0,
   "end": 3.16,
   "text": "Logistika diishleydiygan dispachillar yaxsh pul topshini bilasizda."
  },
  {
   "start": 3.2,
   "end": 5.5,
   "text": "Sizam ingilisdini bilasizd dispachir bulmaksiz."
  },
  {
   "start": 5.8,
   "end": 10.64,
   "text": "Lekin qeyirdan organeykin, kim beni logistika gi shikabkir qoyarlidikin dispachir qilavdiy,"
  },
  {
   "start": 10.68,
   "end": 12.28,
   "text": "boylab yurganmiz, siz beni yaxshla beshtin."
  },
  {
   "start": 12.64,
   "end": 14.2,
   "text": "Min 6 yildan meri logistika diishleymendi."
  },
  {
   "start": 14.3,
   "end": 16.5,
   "text": "Khazir kunda okuchilaram, shagirtlaram,"
  },
  {
   "start": 16.84,
   "end": 19.2,
   "text": "logistikanı baslaganiga 1 yil, 2 yil bogan,"
  },
  {
   "start": 19.6,
   "end": 21.92,
   "text": "aige 2.000-3.000 dolar pul top yapdi."
  },
  {
   "start": 21.92,
   "end": 23.92,
   "text": "Ve ulargi ozum logistikanı organip,"
  },
  {
   "start": 24.64,
   "end": 27.28,
   "text": "ozum ulani kampanyaga ishki krisigi yardan vergenmiz."
  },
  {
   "start": 27.28,
   "end": 31.56,
   "text": "Sizam Amerikaya logistikasini urganib kampanyalargi ishke krmokchi busiz"
  },
  {
   "start": 31.56,
   "end": 33.76,
   "text": "vay logistikani urganib ishlamokchi busiz."
  },
  {
   "start": 33.98,
   "end": 36.88,
   "text": "Pasaytugum orxali onyxat tanuti, uzmiz aloqa ichxinman modderamiz."
  }
 ],
