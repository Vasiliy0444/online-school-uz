  {
   "start": 0.0,
   "end": 2.84,
   "text": "Online ingilisili orga tamizdiyan elalani kob koratsiz."
  },
  {
   "start": 2.84,
   "end": 4.68,
   "text": "Lekin, Inglify nimasi baran ajiralib turadi,"
  },
  {
   "start": 4.68,
   "end": 6.0,
   "text": "va nima natici beri aladi."
  },
  {
   "start": 6.0,
   "end": 7.32,
   "text": "Manda misal chun bittli fungtsiamiz,"
  },
  {
   "start": 7.32,
   "end": 8.12,
   "text": "menin logatim."
  },
  {
   "start": 8.12,
   "end": 9.84,
   "text": "Bu, Gavard Univsitetinin"
  },
  {
   "start": 9.84,
   "end": 12.72,
   "text": "1, 3, 7, 30 metri digi asaslanigyan bolib,"
  },
  {
   "start": 12.72,
   "end": 14.68,
   "text": "u yirda siz sozlanig zirikmastan,"
  },
  {
   "start": 14.68,
   "end": 17.36,
   "text": "hatta ki, yotlovatka iziyan bilmastan turuk orga nasilisi,"
  },
  {
   "start": 17.36,
   "end": 18.32,
   "text": "va eni mukhumi,"
  },
  {
   "start": 18.32,
   "end": 19.96,
   "text": "bir umurgi esizdi qaladi."
  },
  {
   "start": 19.96,
   "end": 22.32,
   "text": "Bu, onti fungtsiamizdan bittlis xalaz."
  },
  {
   "start": 22.32,
   "end": 24.2,
   "text": "Uzingiz, hamasini faydalanib korin"
  },
  {
   "start": 24.2,
   "end": 25.2,
   "text": "va ishanich khasir kirin."
  }
 ],
