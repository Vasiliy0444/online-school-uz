  },
  {
   "start": 9.74,
   "end": 12.52,
   "text": "Tasi Oracle-in 21.000 kishini ishtan boshatikan."
  },
  {
   "start": 12.94,
   "end": 16.04,
   "text": "Yo kimet? Facebook. 8.000 xadummi ishtan boshatikan."
  },
  {
   "start": 16.14,
   "end": 17.9,
   "text": "Budigani 10% qisqartirish."
  },
  {
   "start": 18.18,
   "end": 20.38,
   "text": "Wa bu faqat IT korparatsiyali edamaz."
  },
  {
   "start": 20.5,
   "end": 22.04,
   "text": "Bosqa soxaladi ham doham edwaddi."
  },
  {
   "start": 22.04,
   "end": 26.04,
   "text": "UPS. Hamamiz tani edigan logistika soxasdigi gigant."
  },
  {
   "start": 26.04,
   "end": 28.44,
   "text": "12000 managerri ishtan boshatgan"
  },
  {
   "start": 28.44,
   "end": 31.08,
   "text": "vay yani 30.000-to xadimmi boshatish boychi"
  },
  {
   "start": 31.08,
   "end": 32.2,
   "text": "ilan bergan."
  },
  {
   "start": 32.72,
   "end": 33.44,
   "text": "Tasor qaslam."
  },
  {
   "start": 33.54,
   "end": 36.56,
   "text": "Yani suni intelek cudayam yukara tembladar vajlan vatda"
  },
  {
   "start": 36.56,
   "end": 38.7,
   "text": "vay bizan aldimizda bari oga ikiti tanlo bar."
  },
  {
   "start": 39.1,
   "end": 40.24,
   "text": "Yoki biz ono cilo ulab,"
