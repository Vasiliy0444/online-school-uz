  {
   "start": 40.36,
   "end": 41.32,
   "text": "oz kolimizgi alamiz,"
  },
  {
   "start": 41.64,
   "end": 42.86,
   "text": "yoki biz onge maqlub bolib,"
  },
  {
   "start": 42.92,
   "end": 44.66,
   "text": "cemiyatta oz ornimiz yuqatamiz."
  },
  {
   "start": 44.78,
   "end": 46.66,
   "text": "Banyam chi, kinchi varyant qiqin ge toruk e mese geri."
  },
  {
   "start": 47.12,
   "end": 49.08,
   "text": "Shu sababli, silagi maslakat beradganim,"
