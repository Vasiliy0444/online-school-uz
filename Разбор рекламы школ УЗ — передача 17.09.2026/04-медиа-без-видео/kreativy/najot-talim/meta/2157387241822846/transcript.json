 "segments": [
  {
   "start": 0.0,
   "end": 1.32,
   "text": "Aktovizakat nesim inqanmida?"
  },
  {
   "start": 1.32,
   "end": 2.32,
   "text": "Yo, shopurimda."
  },
  {
   "start": 5.5,
   "end": 7.48,
   "text": "Man nasimim Nasir Khan, yashim 14-di,"
  },
  {
   "start": 7.48,
   "end": 9.24,
   "text": "makhtabda oqiyimma, talishkin shahadamma."
  },
  {
   "start": 9.24,
   "end": 11.12,
   "text": "14 yashi zinima macburlamad, uqishki?"
  },
  {
   "start": 11.12,
   "end": 13.28,
   "text": "Shishim macburlamadib, shu akamuz oqirdili,"
  },
  {
   "start": 13.28,
   "end": 15.28,
   "text": "najat talimdi, khadiridi, fulsik."
  },
  {
   "start": 15.28,
   "end": 16.32,
   "text": "Otonizmich qirishad?"
  },
  {
   "start": 16.32,
   "end": 17.18,
   "text": "Biznismeli adam,"
  },
  {
   "start": 17.18,
   "end": 19.32,
   "text": "moshnis otalli, ayim ubekesili."
  },
  {
   "start": 19.32,
   "end": 21.32,
   "text": "Itabiriyasim, hammet tavsiyebina ki gansiz."
  },
  {
   "start": 21.32,
   "end": 23.52,
   "text": "Ertigi sizim tarziyaklarishiz uchi yashin sumubchik,"
  },
  {
   "start": 23.52,
   "end": 24.32,
   "text": "qidalishiz kirey."
  },
  {
   "start": 24.32,
   "end": 26.76,
   "text": "Sizgi, bilim, bilikin adamlar natuur adamlar ma shunu bilin."
  },
  {
   "start": 26.76,
   "end": 28.44,
   "text": "Yoyki, siz bilikin sarayit natuurmaz."
  },
  {
   "start": 28.44,
   "end": 29.96,
   "text": "Fakat, biyogo, izgi bağlaq qalayabdi."
  },
  {
   "start": 29.96,
   "end": 32.52,
   "text": "Va irtayaz, sizda kibini dökörb ilhamlarina qalayaxirgi quchun,"
  },
  {
   "start": 32.52,
   "end": 34.04,
   "text": "siz muhafakay qerishi shart."
  },
  {
   "start": 34.04,
   "end": 35.16,
   "text": "Kerizay ki rejaylariz, dima?"
  },
  {
   "start": 35.16,
   "end": 35.44,
   "text": "Nasr xar?"
  },
  {
   "start": 35.44,
   "end": 36.04,
   "text": "Kerizaydi."
  },
  {
   "start": 36.04,
   "end": 37.72,
   "text": "Yandix kampanyasi ishla shniyatmim ba?"
  },
  {
   "start": 37.72,
   "end": 38.8,
   "text": "Nimi uchoy, aynay Yandix?"
  },
  {
   "start": 38.8,
   "end": 40.68,
   "text": "Chunki Yandix-si,"
  },
  {
   "start": 40.68,
   "end": 42.56,
   "text": "QOOP platformalarim vordi, harxar."
  },
  {
   "start": 42.56,
   "end": 43.76,
   "text": "Yandix yox adama yux?"
  },
  {
   "start": 43.76,
   "end": 45.2,
   "text": "Demay QOOP platformas bo yalay quchun,"
  },
  {
   "start": 54.32,
   "end": 54.82,
   "text": "Qiparmissin?"
  },
  {
   "start": 54.82,
   "end": 55.32,
   "text": "Qiparim?"
  },
  {
   "start": 55.32,
   "end": 56.32,
   "text": "Met qiqqan qazir?"
  },
  {
   "start": 56.32,
   "end": 57.32,
   "text": "Adashim sami et qiqqum."
  },
  {
   "start": 57.32,
   "end": 58.32,
   "text": "Rasta?"
  },
  {
   "start": 58.32,
   "end": 59.32,
   "text": "Qanak okeydilir?"
  },
  {
   "start": 59.32,
   "end": 60.32,
   "text": "Astoz, uyeyit?"
  },
  {
   "start": 60.32,
   "end": 62.32,
   "text": "Naksay, bakan soq, biyash qizmati zon."
  },
  {
   "start": 62.32,
   "end": 64.32,
   "text": "Camiyatda qanak aroqlar bardib usablayiz?"
  },
  {
   "start": 64.32,
   "end": 65.32,
   "text": "Yuntir yox izda?"
  },
  {
   "start": 65.32,
   "end": 66.32,
   "text": "Nima muamma olay, likur olay apsiz?"
  },
  {
   "start": 66.32,
   "end": 67.32,
   "text": "Balkin start-up qolarsiz?"
  },
  {
   "start": 67.32,
   "end": 68.32,
   "text": "Astor chi, man yumam oyo."
  },
  {
   "start": 68.32,
   "end": 70.32,
   "text": "Aftobuzda qatnaysin min kambida?"
  },
  {
   "start": 70.32,
   "end": 71.32,
   "text": "Yo, shopperim bo."
  },
  {
   "start": 75.32,
   "end": 78.32,
   "text": "Bana shu imkyonayatlayabla nima sizi okishka majburlayabdi?"
  },
  {
   "start": 78.32,
   "end": 81.24,
   "text": "Man imkyuanadlaiz yaxshay kyanadadiz, hatta shopariz gechi veribdi."
  },
  {
   "start": 81.24,
   "end": 82.68,
   "text": "Nima sizi macburlayabdi uqishki?"
  },
  {
   "start": 82.68,
   "end": 84.76,
   "text": "Macburlayaz prostor, ozum qizi qishim, la."
  },
  {
   "start": 84.76,
   "end": 85.68,
   "text": "Shuu uqolmah."
  },
  {
   "start": 85.68,
   "end": 86.18,
   "text": "Istimi macburlayabdi?"
  },
  {
   "start": 86.18,
   "end": 87.72,
   "text": "Ota nizgiye lxamati yaxs tarbayi verishi yabdi kyan."
  },
  {
   "start": 87.72,
   "end": 90.04,
   "text": "Uz olizgiyaya yaxshun uqishli zilaya kiris timasad qilin."
  },
  {
   "start": 90.04,
   "end": 90.54,
   "text": "Hop."
  },
  {
   "start": 90.54,
   "end": 94.36,
   "text": "Takir oraytaman, bunday kin qaqchon, qana qaldiri mitaplar bozda albayt taqatna shazsi."
  },
  {
   "start": 94.36,
   "end": 95.04,
   "text": "Macburiy."
  },
  {
   "start": 95.04,
   "end": 97.8,
   "text": "Hayat taji bana ayna ushnaka mitaplardan olas."
  },
  {
   "start": 97.8,
   "end": 98.3,
   "text": "Shunu bilin."
  },
  {
   "start": 98.3,
   "end": 99.86,
   "text": "U yoriga barib tarmishlar ori trasidat."
  },
  {
   "start": 99.86,
   "end": 101.1,
   "text": "Nima orzulariz bar hayatta?"
  },
  {
   "start": 101.1,
   "end": 102.74,
   "text": "Hayatta, uspeshli adam boriz."
  },
  {
   "start": 102.74,
   "end": 103.18,
   "text": "O?"
  },
  {
   "start": 103.18,
   "end": 104.38,
   "text": "Dastur chiliyar gasdan."
  },
  {
   "start": 104.38,
   "end": 104.94,
   "text": "Mm-hmm."
  },
  {
   "start": 104.94,
   "end": 106.18,
   "text": "Ota anamli,"
  },
  {
   "start": 106.18,
   "end": 107.9,
   "text": "shu beratgan puliyyina aqlab."
  },
  {
   "start": 107.9,
   "end": 109.14,
   "text": "Kitab okub trasim?"
  },
  {
   "start": 109.14,
   "end": 110.54,
   "text": "Qanaka kitab okudzi ahirgim etdi?"
  },
  {
   "start": 110.54,
   "end": 111.58,
   "text": "Ruschi kitab ila okuyim, ha?"
  },
  {
   "start": 111.58,
   "end": 112.58,
   "text": "Uzbitili de kyan okuyim?"
  },
  {
   "start": 112.58,
   "end": 113.46,
   "text": "Okuyim sen moli?"
  },
  {
   "start": 113.46,
   "end": 113.9,
   "text": "Negi?"
  },
  {
   "start": 113.9,
   "end": 115.42,
   "text": "Adam uz tilin deyandakin kitab okush geli?"
  },
  {
   "start": 115.42,
   "end": 116.42,
   "text": "Uzbitili okuyim, ha?"
  },
  {
   "start": 116.42,
   "end": 116.74,
   "text": "Kyan?"
  },
  {
   "start": 116.74,
   "end": 117.66,
   "text": "Okuyin, tavsiyam."
  },
  {
   "start": 117.66,
   "end": 118.46,
   "text": "Mm."
  },
  {
   "start": 118.46,
   "end": 120.02,
   "text": "Ho, psiziyo, ashiziyay tsam."
  },
  {
   "start": 120.02,
   "end": 121.56,
   "text": "Saal orte, saal tor giladi."
  },
  {
   "start": 121.56,
   "end": 123.56,
   "text": "Daki, un tor yashiz ishun dima, tor gila."
  },
  {
   "start": 123.56,
   "end": 125.56,
   "text": "Sadogyalar istazima?"
  },
  {
   "start": 125.56,
   "end": 127.56,
   "text": "Ya, ushinu okeyin, Sadogyalar istazima,"
  },
  {
   "start": 127.56,
   "end": 128.56,
   "text": "astan zor kitab."
  },
  {
   "start": 128.56,
   "end": 130.56,
   "text": "Kin, yana bita, gayaan diyan kitab bar, ushinu okeyin."
  },
  {
   "start": 130.56,
   "end": 131.56,
   "text": "Gayaan minan ash kitab."
  },
  {
   "start": 131.56,
   "end": 132.56,
   "text": "Sigab arz u okolish,"
  },
  {
   "start": 132.56,
   "end": 133.56,
   "text": "masad qolish u okitadi."
  },
  {
   "start": 133.56,
   "end": 134.06,
   "text": "Oladim?"
  },
  {
   "start": 134.06,
   "end": 134.56,
   "text": "Ola."
  },
  {
   "start": 134.56,
   "end": 135.56,
   "text": "Atanizgi rahmat."
  },
  {
   "start": 135.56,
   "end": 137.56,
   "text": "Asil shok u ila, shoy gitki."
  }
