{
 "model": "mlx-community/whisper-large-v3-mlx",
 "language": "uz",
 "segments": [
  {
   "start": 0.0,
   "end": 0.92,
   "text": "Kurs pirlin kimi tolayab?"
  },
  {
   "start": 0.92,
   "end": 1.42,
   "text": "Uzum."
  },
  {
   "start": 1.42,
   "end": 2.12,
   "text": "O'qish xan nidi tolayab?"
  },
  {
   "start": 2.12,
   "end": 3.12,
   "text": "Kurir bu o'qishlayim haq."
  },
  {
   "start": 3.12,
   "end": 3.62,
   "text": "Hazir hama?"
  },
  {
   "start": 3.62,
   "end": 4.48,
   "text": "Ismim Yelbek."
  },
  {
   "start": 4.48,
   "end": 5.46,
   "text": "Naman geyim olayab ati?"
  },
  {
   "start": 5.46,
   "end": 6.34,
   "text": "Popdum a'ndan ma."
  },
  {
   "start": 6.34,
   "end": 8.0,
   "text": "O'qish uchun popdan keldiiz, shunakam?"
  },
  {
   "start": 8.0,
   "end": 8.5,
   "text": "Ha."
  },
  {
   "start": 8.5,
   "end": 10.34,
   "text": "Nigi toshkendiyay filiyarimiz geyibaymaldiiz?"
  },
  {
   "start": 10.34,
   "end": 12.18,
   "text": "Bu yurda xarajatlaram a'rzar oq."
  },
  {
   "start": 12.18,
   "end": 13.06,
   "text": "Tohru qan oqigan siz?"
  },
  {
   "start": 13.06,
   "end": 14.68,
   "text": "Barabra bitti okul uyebochi dars bira'yamiz."
  },
  {
   "start": 14.68,
   "end": 15.64,
   "text": "Toshkendiyayim, bu yurdiyayim."
  },
  {
   "start": 15.64,
   "end": 17.54,
   "text": "Ustazda salabala ikenimizda biz chikaqan,"
  },
  {
   "start": 17.54,
   "end": 20.82,
   "text": "Abufarqana iken, ustazda belima kamra buzda bolad digin gebtatmimiz?"
  },
  {
   "start": 20.82,
   "end": 24.9,
   "text": "Yil aydan beri Payitin Cangyo Bekintunarishi di okub gelib ben,"
  },
  {
   "start": 24.9,
   "end": 26.3,
   "text": "hazrda yeddinchi aydanaz."
  },
  {
   "start": 26.3,
   "end": 27.2,
   "text": "Kitab okub turasim?"
  },
  {
   "start": 27.2,
   "end": 28.8,
   "text": "Okuymanim intizam bilanmaz."
  },
  {
   "start": 28.8,
   "end": 29.98,
   "text": "Akhargi okuygan kitab isqaysin?"
  },
  {
   "start": 29.98,
   "end": 32.84,
   "text": "Akhargi okuyganim taleb nasilimdi tasalatikaldan gelin,"
  },
  {
   "start": 32.84,
   "end": 34.4,
   "text": "baslozum in, chunisqin iraq."
  },
  {
   "start": 34.4,
   "end": 36.2,
   "text": "Chunisqin saval artiye savali tasafiliyib ben,"
  },
  {
   "start": 36.2,
   "end": 36.74,
   "text": "nuk yob dirik?"
  },
  {
   "start": 36.74,
   "end": 37.8,
   "text": "Uniyam eshchikodum."
  },
  {
   "start": 37.8,
   "end": 38.48,
   "text": "U talabam?"
  },
  {
   "start": 38.48,
   "end": 40.24,
   "text": "Yang yildi premrimi sat oloodum."
  },
  {
   "start": 40.24,
   "end": 41.58,
   "text": "Burali yukushm chesi oqa menda yana."
  },
  {
   "start": 41.58,
   "end": 42.62,
   "text": "Batalizm esk kli shadi?"
  },
  {
   "start": 42.62,
   "end": 44.72,
   "text": "Dadam ustalar, ayim uybi kasi."
  },
  {
   "start": 44.72,
   "end": 45.64,
   "text": "Kurs pulim kim tolayab?"
  },
  {
   "start": 45.64,
   "end": 47.24,
   "text": "Bazdan uydaylayab, bazdan uzum."
  },
  {
   "start": 47.24,
   "end": 48.14,
   "text": "Uyziqan nid dolayabs?"
  },
  {
   "start": 48.14,
   "end": 49.14,
   "text": "Kuryer bovishlayimay."
  },
  {
   "start": 49.14,
   "end": 49.68,
   "text": "Bazira ma?"
  },
  {
   "start": 49.68,
   "end": 50.94,
   "text": "Karagana da, Narsan Tashkari."
  },
  {
   "start": 50.94,
   "end": 51.74,
   "text": "Neti saat kyunugi?"
  },
  {
   "start": 51.74,
   "end": 54.92,
   "text": "Har xil, tur saatdan bazda 13 saat gechi."
  },
  {
   "start": 54.92,
   "end": 57.68,
   "text": "Kuryerlik ozi yaxsin arsi, lakin kasp kaylan turvarmayi, hop."
  },
  {
   "start": 57.68,
   "end": 59.18,
   "text": "Yani kyunugi uyziqi chigili oku olayim."
  },
  {
   "start": 59.18,
   "end": 61.08,
   "text": "Man torsu at dax qalishim gey, torsu at kuryer bulima."
  },
  {
   "start": 61.08,
   "end": 61.98,
   "text": "Bu vaxtin chalib, bilima?"
  },
  {
   "start": 61.98,
   "end": 63.98,
   "text": "Lekin ushi cariyon da, oda kelan okomas."
  },
  {
   "start": 63.98,
   "end": 65.08,
   "text": "Sus uqshiz kerey avolo."
  },
  {
   "start": 65.08,
   "end": 66.36,
   "text": "Oya o xaragi yakilashgen, na,"
  },
  {
   "start": 66.36,
   "end": 67.68,
   "text": "shunay qobraqshiz kerey avolani,"
  },
  {
   "start": 67.68,
   "end": 68.58,
   "text": "kurs pulim tolashchim."
  },
  {
   "start": 68.58,
   "end": 70.58,
   "text": "Yur ahmak yataygan, tors, fiduayley bu."
  },
  {
   "start": 70.58,
   "end": 71.94,
   "text": "Qanday qab shikir hasis kele ceyda?"
  },
  {
   "start": 71.94,
   "end": 72.78,
   "text": "Layxal arqilib."
  },
  {
   "start": 72.78,
   "end": 73.68,
   "text": "Ingilis silini bilasim?"
  },
  {
   "start": 73.68,
   "end": 75.98,
   "text": "Ingilis silini preenterim edi darajali."
  },
  {
   "start": 75.98,
   "end": 77.78,
   "text": "Sus yudashilaygan aqyan san chikitab okoyabsiz,"
  },
  {
   "start": 77.78,
   "end": 79.54,
   "text": "Mutala var, yasn də blasiz."
  },
  {
   "start": 79.54,
   "end": 81.22,
   "text": "Uzgi sahiz yoyi kempani la blasim?"
  },
  {
   "start": 81.22,
   "end": 82.64,
   "text": "An musal chun yu deyviz var,"
  },
  {
   "start": 82.64,
   "end": 83.82,
   "text": "aydi park, kepan."
  },
  {
   "start": 83.82,
   "end": 85.26,
   "text": "Mirdan yi shikir shikinda vergi."
  },
  {
   "start": 85.26,
   "end": 86.98,
   "text": "Olar tajibali ra mutasiz suriydi."
  },
  {
   "start": 86.98,
   "end": 88.94,
   "text": "Chol junioram kiri ilikim uzgi shangan,"
  },
  {
   "start": 88.94,
   "end": 89.9,
   "text": "tuhtus harakat qolaybi,"
  },
  {
   "start": 89.9,
   "end": 91.1,
   "text": "yi juniorlar kiri olorgi."
  },
  {
   "start": 91.1,
   "end": 92.86,
   "text": "Boshlaniz davra qimi olayz juniorli idi."
  },
  {
   "start": 92.86,
   "end": 94.74,
   "text": "Kiri bosan amiratdiyash liyisiz uchay turayli."
  },
  {
   "start": 94.74,
   "end": 95.42,
   "text": "Otaniz yi rahmat."
  },
  {
   "start": 95.42,
   "end": 97.42,
   "text": "Uzgi yiyem, ishliyab ham okoy kani zhushunar."
  },
  {
   "start": 97.42,
   "end": 98.02,
   "text": "Chachimi."
  }
 ],
