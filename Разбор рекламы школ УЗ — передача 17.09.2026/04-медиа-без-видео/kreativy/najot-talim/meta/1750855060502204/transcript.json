  {
   "start": 0.0,
   "end": 2.0,
   "text": "Toqto, zor kadr."
  },
  {
   "start": 5.0,
   "end": 7.0,
   "text": "Zor kadr."
  },
  {
   "start": 9.0,
   "end": 11.0,
   "text": "Bu kadr ra oma sam bu humi da laykin."
  },
  {
   "start": 11.0,
   "end": 13.0,
   "text": "Toqto, toqto, toqto, man yaqara."
  },
  {
   "start": 13.0,
   "end": 17.0,
   "text": "Kadr la na ola san, zor topasan, qabilatim ban, mabilograf boli pul tap sin chi?"
  },
  {
   "start": 17.0,
   "end": 19.0,
   "text": "Eqshi daromad qalamandak oyla mi man laykin."
  },
  {
   "start": 19.0,
   "end": 25.0,
   "text": "Negunakadi isa, mana, Najat qalamni ikka ili mabilografi kursunu tuyati, ikti uxta lay xali bishli atgallaba."
  },
  {
   "start": 25.0,
   "end": 27.0,
   "text": "Daromadi yan orta jadan yukhar."
  },
  {
   "start": 27.0,
   "end": 29.0,
   "text": "Rostan, magli yundi?"
  },
  {
   "start": 29.0,
   "end": 31.0,
   "text": "An bozu bozu bozu bozu"
  },
