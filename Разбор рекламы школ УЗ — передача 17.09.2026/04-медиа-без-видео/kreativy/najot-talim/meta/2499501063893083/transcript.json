 "segments": [
  {
   "start": 0.0,
   "end": 2.12,
   "text": "Ertiki rasiyege borumasan ishlar shizige bo'alim."
  },
  {
   "start": 2.12,
   "end": 3.32,
   "text": "Cima Nazarifin amcamman."
  },
  {
   "start": 3.32,
   "end": 5.0,
   "text": "Qarazi mula ayatı, bogat diman da yashiman."
  },
  {
   "start": 5.0,
   "end": 7.0,
   "text": "Shoyda tatu da oqimman, uzim 3. kursman."
  },
  {
   "start": 7.0,
   "end": 9.8,
   "text": "Beri Nazarifin alim'e gelishim, ishtimay tarmakmdan yoriyanman."
  },
  {
   "start": 9.8,
   "end": 12.44,
   "text": "Uzimam tatu da oqinanlqim uchinda shilashak zikkanman."
  },
  {
   "start": 12.44,
   "end": 13.64,
   "text": "Kelijiri gelijilarsqan aqa?"
  },
  {
   "start": 13.64,
   "end": 16.0,
   "text": "Aynan ishi, beggin bo'ycha kampanyada ishlaj."
  },
  {
   "start": 16.0,
   "end": 16.92,
   "text": "Kandegi bu ish topansiz?"
  },
  {
   "start": 16.92,
   "end": 18.2,
   "text": "Nazarifin alim'e geyan vaqtim,"
  },
  {
   "start": 18.2,
   "end": 19.64,
   "text": "administratorlar shintirganda,"
  },
  {
   "start": 19.64,
   "end": 21.3,
   "text": "Ixtab Shamiradan baram istagali"
  },
  {
   "start": 21.3,
   "end": 22.88,
   "text": "Nazrat talim, ixtabi bermidi"
  },
  {
   "start": 22.88,
   "end": 24.18,
   "text": "Ixtaklif qilishi munkun halati"
  },
  {
   "start": 24.18,
   "end": 26.06,
   "text": "Lekin, unna kandiyafaydi lan, sizgiye ba'ali"
  },
  {
   "start": 26.06,
   "end": 27.02,
   "text": "Qarazin da xazir"
  },
  {
   "start": 27.02,
   "end": 29.18,
   "text": "Qayzi kampanyi dala bilasiz, bekint iski olay digan"
  },
  {
   "start": 29.18,
   "end": 30.18,
   "text": "Hazir chakabarimi"
  },
  {
   "start": 30.18,
   "end": 31.44,
   "text": "Qani, qarazin da yashkaysiz"
  },
  {
   "start": 31.44,
   "end": 32.48,
   "text": "Urgen iskatsiz, lekin"
  },
  {
   "start": 32.48,
   "end": 34.06,
   "text": "Qayzi kampanyi dala barimini bilmidi, shunaka"
  },
  {
   "start": 34.06,
   "end": 34.9,
   "text": "Nime ge siz iski olasin?"
  },
  {
   "start": 34.9,
   "end": 35.52,
   "text": "U kampanyi yasin"
  },
  {
   "start": 35.52,
   "end": 37.56,
   "text": "Kampanyi dali har doyan, ruwa jenaman digan adamlar kerey"
  },
  {
   "start": 37.56,
   "end": 37.9,
   "text": "Har doyan"
  },
  {
   "start": 37.9,
   "end": 39.32,
   "text": "Boz usunlashliy man, ruwa jenaman"
  },
  {
   "start": 39.32,
   "end": 42.32,
   "text": "Bilim o ol shke har doyim tayyormam, digim odoim ki otorizm eskul shadi"
  },
  {
   "start": 42.32,
   "end": 44.32,
   "text": "Afam zot de shidi, dadam chetibli"
  },
  {
   "start": 44.32,
   "end": 45.32,
   "text": "Asiya"
  },
  {
   "start": 45.32,
   "end": 46.72,
   "text": "Sizi kurs proyizi shundi kim toli yapti?"
  },
  {
   "start": 46.72,
   "end": 48.32,
   "text": "Dadayn giz tolim, asiyada shilabi"
  },
  {
   "start": 48.32,
   "end": 49.32,
   "text": "O son maslada seyli shilashki"
  },
  {
   "start": 49.32,
   "end": 51.32,
   "text": "On bali shikalidni chukayisi u izgiye"
  },
  {
   "start": 51.32,
   "end": 54.32,
   "text": "Negi on dan on okumayab siz, negi en zorubomayab siz"
  },
  {
   "start": 54.32,
   "end": 59.32,
   "text": "Yani bilin har doyim Instagramda otirarkan siz, otam min uchini shilabdi diginansan untimiy"
  },
  {
   "start": 59.32,
   "end": 62.32,
   "text": "O irttagi hayuattizi, o ilizi hayuatini opchikbiyti shizgiye bo'lo"
  },
  {
   "start": 62.32,
   "end": 62.86,
   "text": "Sizge bağlaq."
  },
  {
   "start": 62.86,
   "end": 65.02,
   "text": "Yertdeki rasiye ge barilmarsan ishlar sizge bağlaq."
  },
  {
   "start": 65.02,
   "end": 67.4,
   "text": "Yertdeki dada nizini rasiye edilab geririz sizge bağlaq."
  },
  {
   "start": 67.46,
   "end": 70.16,
   "text": "Butun umri vizdan azabli yashamasini gochun insa hayotini togur qorush gerik."
  },
  {
   "start": 70.18,
   "end": 71.34,
   "text": "Bu subatimiz hayotizi uzgatiradi."
  },
  {
   "start": 71.42,
   "end": 71.98,
   "text": "Vada veri baytani."
  },
  {
   "start": 72.04,
   "end": 72.66,
   "text": "Ayya amaq siz."
  },
  {
   "start": 72.78,
   "end": 73.42,
   "text": "Otoriniz ye rahmat."
  }
