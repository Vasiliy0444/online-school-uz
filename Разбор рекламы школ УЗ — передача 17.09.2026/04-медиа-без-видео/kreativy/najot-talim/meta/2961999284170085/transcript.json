  {
   "start": 0.0,
   "end": 3.54,
   "text": "Kichin asan oriyanmasi ikirey dilgen balayam shi ushtan asan oriyanish sili."
  },
  {
   "start": 3.54,
   "end": 5.26,
   "text": "Ismim Azize, 41 yashda man."
  },
  {
   "start": 5.34,
   "end": 7.9,
   "text": "Yaq kaayil laykin, 41 yashda izde oqibiruz zaykin."
  },
  {
   "start": 8.54,
   "end": 10.72,
   "text": "Nima mazub okilda sizi 41 yashda talim alish?"
  },
  {
   "start": 10.74,
   "end": 13.32,
   "text": "Karantin boshlan gendiki, balarimla uido otirp aldimdi."
  },
  {
   "start": 13.38,
   "end": 15.54,
   "text": "Uido otirsam, sal mazam bami yurdim."
  },
  {
   "start": 15.8,
   "end": 18.96,
   "text": "Balarim geyam uzi, ulan o bilmaslik ozumgen yito boldi."
  },
  {
   "start": 19.02,
   "end": 21.06,
   "text": "Pashka jodan, xamma savolagi jabiraman,"
  },
  {
   "start": 21.16,
   "end": 23.78,
   "text": "kompiterdan, anchen arsi, kruajlanish boq kitkenike."
  },
  {
   "start": 23.78,
   "end": 25.26,
   "text": "xamma kurslan okup chqib, endib"
  },
  {
   "start": 25.26,
   "end": 26.22,
   "text": "majad talim qoygeni qen,"
  },
  {
   "start": 26.22,
   "end": 27.14,
   "text": "shin okup qoydi qeldim."
  },
  {
   "start": 27.14,
   "end": 29.26,
   "text": "Bundan ikiyen, xazir ki ganymda bildim,"
  },
  {
   "start": 29.26,
   "end": 30.66,
   "text": "ngilisili dan qinal shimmi,"
  },
  {
   "start": 30.66,
   "end": 31.42,
   "text": "bollarim bili shadi,"
  },
  {
   "start": 31.42,
   "end": 33.62,
   "text": "ula bilan qoshilib okuma ganymga afslandim."
  },
  {
   "start": 33.62,
   "end": 34.34,
