{
 "model": "mlx-community/whisper-large-v3-mlx",
 "language": "uz",
 "segments": [
  {
   "start": 0.0,
   "end": 2.0,
   "text": "Balaman, bazilat in oqil yiplini biri bugut yadim."
  },
  {
   "start": 2.0,
   "end": 4.0,
   "text": "Ismim Otabi, yashim 16-di."
  },
  {
   "start": 4.0,
   "end": 5.0,
   "text": "Namuch aynam dizayn."
  },
  {
   "start": 5.0,
   "end": 6.0,
   "text": "Nazir talim kili shimda olnum."
  },
  {
   "start": 6.0,
   "end": 8.0,
   "text": "Kocayda, yoki, YouTube-da adlo shkala kurdim ma."
  },
  {
   "start": 8.0,
   "end": 10.0,
   "text": "Ushi rastimda yiqizikka biya sab kursh niyat bujim."
  },
  {
   "start": 10.0,
   "end": 12.0,
   "text": "Kanan xoqa yapis kurshda?"
  },
  {
   "start": 12.0,
   "end": 14.0,
   "text": "Uyizgi 10 ballishkala dama xoqayin."
  },
  {
   "start": 14.0,
   "end": 15.0,
   "text": "Zingi 10-mas."
  },
  {
   "start": 15.0,
   "end": 16.0,
   "text": "Otani zimesh kurshada?"
  },
  {
   "start": 16.0,
   "end": 18.0,
   "text": "Dadam score-di haydo uchi."
  },
  {
   "start": 18.0,
   "end": 20.0,
   "text": "Ayam huazur xam okuydi, am baxchada tarbi atchi."
  },
  {
   "start": 20.0,
   "end": 22.44,
   "text": "Otone sizge uzlarin fidaqli bokut shiyab, torum"
  },
  {
   "start": 22.44,
   "end": 23.9,
   "text": "En yasisi borisda nima tosiyab sizi"
  },
  {
   "start": 23.9,
   "end": 25.1,
   "text": "Otone ane puli istrofti"
  },
  {
   "start": 25.1,
   "end": 26.6,
   "text": "Bakshi okumay ikan, molar okumay indi imi"
  },
  {
   "start": 26.6,
   "end": 27.6,
   "text": "Toru otone la itshimi kin"
  },
  {
   "start": 27.6,
   "end": 29.1,
   "text": "2 yasiyyatda, bakti otayda, boshka yog"
  },
  {
   "start": 29.1,
   "end": 30.4,
   "text": "Nima ki, hima balladan"
  },
  {
   "start": 30.4,
   "end": 32.84,
   "text": "Otoy zime shqilaydi, oroy zime shqilaydi dada sorimam, blasimi?"
  },
  {
   "start": 32.84,
   "end": 34.04,
   "text": "Otone asin chunushimi chuni"
  },
  {
   "start": 34.04,
   "end": 36.16,
   "text": "Eni, blamim, bazilad eni okhoy pulini bira bokut yad"
  },
  {
   "start": 36.16,
   "end": 37.7,
   "text": "Qisqilin shunar sanay, gitlar, qizlar"
  },
  {
   "start": 37.7,
   "end": 38.96,
   "text": "Balgi sizmatsiz bunar san"
  },
  {
   "start": 38.96,
   "end": 40.1,
   "text": "Lekin, mo xokemalar blad"
  },
  {
   "start": 40.1,
   "end": 42.34,
   "text": "bu pul da kaki shatamiz diyan"
  },
  {
   "start": 42.34,
   "end": 44.06,
   "text": "farzand ola da yapashir midi bu masallar?"
  },
  {
   "start": 44.06,
   "end": 46.22,
   "text": "osanmaz, yol krizgi pul tabbe osanmaz bazidi"
  },
  {
   "start": 46.22,
   "end": 47.7,
   "text": "har ili kimla kishin oqoladi"
  },
  {
   "start": 47.7,
   "end": 49.02,
   "text": "aynasa osmrli payitdi dasiz"
  },
  {
   "start": 49.02,
   "end": 51.3,
   "text": "14-16 diyan kimiz 15-12 torqe midi?"
  },
  {
   "start": 51.3,
   "end": 52.86,
   "text": "bu payitdi xamat qalarlish kiri"
  },
  {
   "start": 52.86,
   "end": 54.14,
   "text": "en zora borlash karikat qalish kiri"
  },
  {
   "start": 54.14,
   "end": 55.58,
   "text": "telefoni izlan kaysa oyinlar var?"
  },
  {
   "start": 55.58,
   "end": 56.46,
   "text": "haldi oyinar dimi?"
  },
  {
   "start": 56.46,
   "end": 58.42,
   "text": "youtube gani, o shay streamer, bomaxchi, bugamdi?"
  },
  {
   "start": 58.42,
   "end": 59.94,
   "text": "oya topgan kaskini qarar"
  },
  {
   "start": 59.94,
   "end": 61.42,
   "text": "hammeylar icbi oyin oyinamiyim"
  },
  {
   "start": 61.42,
   "end": 63.54,
   "text": "telefon shatim, organ valdi ila varki"
  },
  {
   "start": 63.54,
   "end": 67.86,
   "text": "Menge qizq qiyin, nigi qorqindan faydalanmayabsi kilib, nigi ussidze qib rashlamayabsisiz."
  },
  {
   "start": 67.86,
   "end": 72.06,
   "text": "Qorqindi yashtar aqta ilim aalish uchun hamma birtta joyda boladiki, tez mostaq qitasdi."
  },
  {
   "start": 72.06,
   "end": 74.98,
   "text": "Qoraxsiz qarisi qibin dastudar uganiabdi, qibindar isi yamayana dizayin,"
  },
  {
   "start": 74.98,
   "end": 77.54,
   "text": "basaxa qilishi quchun azalma qib boladidi, dunyo qarashilam uganiabsisiz."
  },
  {
   "start": 77.54,
   "end": 81.5,
   "text": "Qorqindi harqindi yangi tarinishlar arttirasiz, shu qizqda, biz juzi erkilili davri daishimiz."
  },
  {
   "start": 81.5,
   "end": 83.5,
   "text": "qiyin davrida zor insolar fayda buyinda"
  },
  {
   "start": 83.5,
   "end": 85.5,
   "text": "qazi yakilli davrida juzi erkinlarimki tevstam"
  },
  {
   "start": 85.5,
   "end": 87.5,
   "text": "telfon oynamiyilar ilaji barcid, tahsiya qamiman"
  },
  {
   "start": 87.5,
   "end": 89.5,
   "text": "uzirayi uzirayi chekili okuyilar, kitob okuyilar"
  },
  {
   "start": 89.5,
   "end": 91.5,
   "text": "maksimal fayda ranyan vaqtdan, vaqt juzi qimmat nas ali"
  },
  {
   "start": 91.5,
   "end": 93.5,
   "text": "adanla tulgayki nisharilab otiraydi ku"
  },
  {
   "start": 93.5,
   "end": 95.5,
   "text": "bu nimas nisharlaysan, dima yerishdiyin"
  },
  {
   "start": 95.5,
   "end": 97.5,
   "text": "adan ozi bila sarxisa qilish kiri, ushnaqa kullarini"
  },
  {
   "start": 97.5,
   "end": 99.5,
   "text": "isan otikan umrigi qalish kiri, chunki bu vaqt nas"
  },
  {
   "start": 99.5,
   "end": 101.5,
   "text": "umrda, maqt otmayat, umr otayat"
  },
  {
   "start": 101.5,
   "end": 105.34,
   "text": "Muxum qayda bu, shunak qa ma'isatna yashiyyilar, qaytar bu meydi, bu bu chekilanya, bu to gado."
  },
  {
   "start": 105.34,
   "end": 108.26,
   "text": "U shi vaqt davamada shunak qa bal insan bolin ki insolarsiz ban fakhirlansin."
  },
  {
   "start": 108.26,
   "end": 110.94,
   "text": "Kukiraygan kirib yaparsin, mu falanchin kushursi bolam."
  },
  {
   "start": 110.94,
   "end": 113.74,
   "text": "O izan namalda qaldira olaygan, dardirizdiyin insan boli olayin."
  },
  {
   "start": 113.74,
   "end": 117.9,
   "text": "Yigitla ayansasilar, qizilar sikilar shunaka ilim olaylar ki, sikilar shunaka farizan talibiyalaylar ki,"
  },
  {
   "start": 117.9,
   "end": 121.1,
   "text": "sikilar tahaybiyalayan farizandilar duniyonu uzgatiraygan insolmob chiksin."
  },
  {
   "start": 121.1,
   "end": 121.86,
   "text": "An imkayarayda boar"
  },
  {
   "start": 121.86,
   "end": 122.82,
   "text": "An zuch zuch boar zuch"
  },
  {
   "start": 122.82,
   "end": 123.1,
   "text": "An zuch zuch boar zuch"
