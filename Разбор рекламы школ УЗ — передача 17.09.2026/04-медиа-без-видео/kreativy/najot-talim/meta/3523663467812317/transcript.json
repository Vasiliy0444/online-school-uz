   "text": "tanimi iman, ono nido, ono yagali di iski hakqiz yok"
  },
  {
   "start": 89.14,
   "end": 90.86,
   "text": "kanakarishki yirmaksti erte, bitirigandanki"
  },
  {
   "start": 90.86,
   "end": 92.06,
   "text": "Amaniyot bulag?"
  },
  {
   "start": 92.06,
   "end": 93.26,
   "text": "Qaisi kampanyan ish kekir mohchiz?"
  },
  {
   "start": 93.26,
   "end": 95.56,
   "text": "Tavsiyaqigan bolag, mir payetlizda proyektik kiyotarib yetisdi."
  },
  {
   "start": 95.56,
   "end": 99.8,
   "text": "Kursi uryanyayken payetizdi, bugi uryanyan yansizigan mohchizda proyektin invadar qismin davam etirib kiyoturilaz har kuna."
  },
  {
   "start": 99.8,
   "end": 101.0,
   "text": "Qaisi kampanyan ish kekir mohchiz?"
  },
  {
   "start": 101.0,
   "end": 104.7,
   "text": "Hazir, bashlanqich oku yapbano, sakiz ay okuyandaygin, blamb."
  },
  {
   "start": 104.7,
   "end": 106.46,
   "text": "Sizi altaynayki uzgarib qalamanda boyurisim?"
  },
  {
   "start": 106.46,
   "end": 107.72,
   "text": "Oqushim boych, ilmim boych."
  },
  {
   "start": 107.72,
   "end": 109.7,
   "text": "Ilmimiz boych, legin duniyo qarashi boych uzgaribmiz."
  },
  {
   "start": 109.7,
   "end": 111.46,
   "text": "yani siz kays kampanyash ki oladda, oylav korynchi?"
  },
  {
   "start": 111.46,
   "end": 113.66,
   "text": "Kampany, an xazr oylav koryanm yoy orostan shi?"
  },
  {
   "start": 113.66,
   "end": 115.78,
   "text": "O, xazrdan oryani, o brykun oryani giondar samas?"
  },
  {
   "start": 115.78,
   "end": 117.86,
   "text": "Shoni, brykun yoy orgin olm niz, aga siz xazrdan"
  },
  {
   "start": 117.86,
   "end": 120.02,
   "text": "kays kampanyash karch bojidja, masal dzi anabogin dzi,"
  },
  {
   "start": 120.02,
   "end": 121.7,
   "text": "koshimchad nimay ilimla olish karyay diga,"
  },
  {
   "start": 121.7,
   "end": 122.82,
   "text": "maysad dzi shakrlan amin."
  },
  {
   "start": 122.82,
   "end": 125.06,
   "text": "Unichin insonyin kupra balim karyay, kupra tajriba karyay."
  },
  {
   "start": 125.06,
   "end": 126.82,
   "text": "Kaysa fulgstayg dast surchila rtan yisis?"
  },
  {
   "start": 126.82,
   "end": 129.74,
   "text": "Dasar chala balimi balay ki kampanyala uzum, payimi?"
  },
  {
   "start": 129.74,
   "end": 131.28,
