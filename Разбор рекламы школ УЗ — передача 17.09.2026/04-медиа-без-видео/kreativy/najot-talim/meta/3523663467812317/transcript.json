   "text": "dunayon yaragli tuki toqtamayin."
  },
  {
   "start": 63.8,
   "end": 65.76,
   "text": "Shunun chini ilofan shurik darazayi ki yetibiyin."
  },
  {
   "start": 65.76,
   "end": 67.6,
   "text": "Insana doyim ozgarishkiye ihtiyalci bo."
  },
  {
   "start": 67.6,
   "end": 69.06,
   "text": "Bugun bir yangi malamat olgan diz."
  },
  {
   "start": 69.06,
   "end": 70.38,
   "text": "shus suhbatimizda, otoshimizda"
