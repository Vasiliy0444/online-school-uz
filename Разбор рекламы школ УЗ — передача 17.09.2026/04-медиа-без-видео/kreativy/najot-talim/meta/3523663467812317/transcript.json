  {
   "start": 58.2,
   "end": 60.12,
   "text": "Ozgarimaygan yeganan arsa, bo, ozgarishdir."
  },
  {
   "start": 60.12,
   "end": 62.64,
   "text": "Yani, ozgarish insana har doymir, wajlarnishi,"
