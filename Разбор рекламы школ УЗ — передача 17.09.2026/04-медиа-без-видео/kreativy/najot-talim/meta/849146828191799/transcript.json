 "segments": [
  {
   "start": 0.0,
   "end": 2.52,
   "text": "Bugasib ayal qizlarimiz chun chuddeyan mos gelatdi."
  },
  {
   "start": 2.78,
   "end": 3.94,
   "text": "Ha, togri ishtingiz."
  },
  {
   "start": 4.14,
   "end": 5.12,
   "text": "Bugasib var qalisis,"
  },
  {
   "start": 5.34,
   "end": 6.78,
   "text": "behemolar ergin ish grafikida,"
  },
  {
   "start": 6.92,
   "end": 9.52,
   "text": "u ishlarinizga, o'qishinizga xarakibemagan xolatda,"
  },
  {
   "start": 9.82,
   "end": 10.6,
   "text": "ishleshingiz munkin."
  },
  {
   "start": 10.82,
   "end": 13.08,
   "text": "Bu, xazirgi kunda gozaylik sanolari,"
  },
  {
   "start": 13.22,
   "end": 14.28,
   "text": "moda, psihologi,"
  },
  {
   "start": 14.5,
   "end": 15.52,
   "text": "va talim yonalishlarda,"
  },
  {
   "start": 15.66,
   "end": 16.5,
   "text": "kontent yaratish,"
  },
  {
   "start": 16.74,
   "end": 18.84,
   "text": "va qizxalil ayukhalarda ishlesh munkun bolgan,"
  },
  {
   "start": 19.16,
   "end": 19.94,
   "text": "ishimim soxasi."
  },
  {
   "start": 20.24,
   "end": 21.86,
   "text": "Bugasib natigi toroi davamida,"
  },
  {
   "start": 21.98,
   "end": 24.42,
   "text": "Nacatayli markezda mukemmal organ shingiz munkun."
  },
  {
   "start": 24.42,
   "end": 25.82,
   "text": "Ayal qizlarimiz chun isi,"
  },
  {
   "start": 25.82,
   "end": 27.58,
   "text": "un fosilik tigirmamiz xam mavcud."
  },
  {
   "start": 27.9,
   "end": 29.5,
   "text": "Dologroq malumat alish uchun isa"
  },
  {
   "start": 29.5,
   "end": 30.6,
   "text": "xaziroq royxat tauntin."
  }
 ],
