  },
  {
   "start": 18.16,
   "end": 20.62,
   "text": "maliyo bazorlan kotarilash, va chushi vaktlaran anigilash,"
  },
  {
   "start": 20.62,
   "end": 22.84,
   "text": "Risk Management asosida xabsiz savda oqilash,"
  },
  {
   "start": 22.96,
   "end": 24.72,
   "text": "va kapital bashqarishni orgenis."
  },
  {
   "start": 24.72,
