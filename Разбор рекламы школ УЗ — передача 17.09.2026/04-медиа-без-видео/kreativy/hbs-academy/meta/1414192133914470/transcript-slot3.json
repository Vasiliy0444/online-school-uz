   "text": "Trading haqida ki ishla ishlanini bilmisimi?"
  },
  {
   "start": 2.94,
   "end": 5.0,
   "text": "Undi bu kurs aynani siz uchun."
  },
  {
   "start": 5.0,
   "end": 7.5,
   "text": "Express kursimizdi talim nolidan bashlanib."
  },
  {
   "start": 7.5,
   "end": 9.32,
   "text": "Akci bazari qaniq ishlashi,"
  },
  {
   "start": 9.32,
   "end": 10.92,
   "text": "jahiz aksivlani saralash,"
  },
  {
   "start": 10.92,
   "end": 12.16,
   "text": "riski bashqarish"
