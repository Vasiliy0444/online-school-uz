  },
  {
   "start": 15.76,
   "end": 17.2,
   "text": "Darsili talshgin shahridi"
  },
  {
   "start": 17.2,
   "end": 18.96,
   "text": "amaliyatchi traderladlan birgi"
  },
  {
   "start": 18.96,
   "end": 20.28,
   "text": "offline tarzidi otilib."
  },
  {
   "start": 20.28,
   "end": 22.52,
   "text": "Tradingi mustaqili orginib, vaxt yokotmik."
  },
  {
   "start": 22.52,
   "end": 24.72,
   "text": "Pasti gurtigimani basib, formani toldirin"
  },
  {
