 "segments": [
  {
   "start": 0.0,
   "end": 12.0,
   "text": "International School Anıcan filiali xayratlan tirishta dolam etadi. Bizda yana bir naticayla bu safar odin naticaylar dan imas. International School Anıcan filiali birinci ayil sakiz baltoxibi marhamat kutub olim."
  },
  {
   "start": 12.0,
   "end": 21.88,
   "text": "Эттеглэр курсанмен бұнэка результатан аламэн деп ойламодым,"
  },
  {
   "start": 21.88,
   "end": 26.72,
   "text": "тоуруси бекен ИнтерNation-ay-u ғustazlarım və batfoğn-ımən yordamıdı"
  },
  {
   "start": 26.72,
   "end": 28.24,
   "text": "бұнэka rezultatat-a girish etmən."
  },
  {
   "start": 28.32,
   "end": 29.48,
   "text": "ИнтерNation-i katta rahmat."
  },
  {
   "start": 29.64,
   "end": 31.62,
   "text": "Ая сускам аялсан юкар-бал алыб,"
  },
  {
   "start": 31.68,
   "end": 33.98,
   "text": "аят-ингиз нян-ги бақ-су алыб-чу ма-хсу-мол-сан-гиз,"
  },
  {
   "start": 34.02,
   "end": 34.8,
   "text": "а-л-л-а-м-ингиз an-ын."
  },
  {
   "start": 34.98,
   "end": 36.54,
   "text": "ИнтерNation, nate-ci-qilad-in-coy."
  },
  {
   "start": 36.54,
   "end": 38.34,
   "text": "Havale orxali ruikatdanud."
  }
 ],
