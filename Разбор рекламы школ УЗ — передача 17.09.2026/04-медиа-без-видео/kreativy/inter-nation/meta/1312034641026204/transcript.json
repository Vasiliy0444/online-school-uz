   "text": "choy chams."
  },
  {
   "start": 8.0,
   "end": 10.0,
   "text": "Bani o'li ayil tismi, bindime sertifikat"
  },
  {
   "start": 10.0,
   "end": 12.0,
   "text": "awabdi. Sho, sertifikat bilan, kana qadar"
  },
  {
   "start": 12.0,
   "end": 14.0,
   "text": "yaxsh yaxsh oqishlargi kirse bolarkyan."
  },
  {
   "start": 14.0,
   "end": 16.0,
   "text": "Sinam ingilisdilini urgan va sin bolardi."
  },
  {
   "start": 16.0,
   "end": 18.0,
   "text": "Ha, ayi, uzman xarkat"
  },
  {
   "start": 18.0,
   "end": 20.0,
   "text": "xiliyat ban. Kündüzü bilan ishim bar."
  },
  {
   "start": 20.0,
   "end": 22.0,
   "text": "Kechik bayi di bozsa yaxsh ingilisdili kurslar"
  },
  {
   "start": 22.0,
   "end": 24.0,
   "text": "yogakyan da, uzman boykona qidrdim,"
  },
  {
   "start": 24.0,
   "end": 26.0,
   "text": "topamadim bich qaydin yaxsh kurslu."
  },
  {
   "start": 26.0,
   "end": 28.0,
   "text": "Bani aldimizdagi internationalda, 18-30-di"
