  {
   "start": 59.02,
   "end": 60.92,
   "text": "Зо, уч зоним?"
  },
  {
   "start": 61.04,
   "end": 61.56,
   "text": "Дильнурэ."
  },
  {
   "start": 61.64,
   "end": 67.54,
   "text": "Дильнурэ. Лыснини току зоудзэ. Нэмэйо Йорданберд Интернешн. Мучу лыснини току зоудзэ?"
  },
  {
   "start": 67.54,
   "end": 75.92,
   "text": "Я когда делала лыснини, я постоянно запутывалась, потому што обращала внимание на ложные ответы и не читала полностью сам вопрос."
  },
  {
   "start": 76.18,
   "end": 84.72,
   "text": "Этот курс научил меня, как анализировать вопросы и как работать с тестом самим, а не только с аудиодорожным."
  },
  {
   "start": 84.72,
   "end": 86.8,
   "text": "Zor. Uchi zioneyim?"
  },
  {
   "start": 86.92,
   "end": 87.4,
   "text": "Mahtuna."
  },
  {
   "start": 87.54,
   "end": 90.02,
   "text": "Mahtuna. Siz reading-da sak gizanim olumus."
  },
  {
   "start": 90.36,
   "end": 92.2,
   "text": "International, sizgen. Nima bilan yordan belim?"
  },
  {
   "start": 92.38,
   "end": 97.42,
   "text": "Birinche, aval uzun reading-plasticilani ishlagyanimda, fakat kino uzun logikani ishlag yedikbayardim."
  },
  {
   "start": 97.52,
   "end": 101.88,
   "text": "Shuk problemeydi, oktulchi mengi reading-dagi materiyallani okayatkanida,"
  },
  {
   "start": 101.94,
   "end": 106.24,
   "text": "yangi malamat yurganiyatkanizik xalib, reading-dagi okatlanib ishlasinmasi ahab berdi."
  },
  {
   "start": 106.78,
   "end": 107.56,
   "text": "Shui yordan belim?"
  },
  {
   "start": 107.7,
   "end": 109.42,
   "text": "Zor. Uchi zioneyim, sad?"
  },
  {
   "start": 109.74,
   "end": 110.32,
   "text": "Manayim, Ivan."
  },
  {
   "start": 110.32,
   "end": 113.62,
   "text": "Ivan, vi palucheli po reading-di busib spalavin."
  },
  {
   "start": 113.62,
   "end": 116.62,
   "text": "Немас с Георгами, што им вам помогло?"
  },
  {
   "start": 143.62,
   "end": 151.24,
   "text": "Korturgenzidek torta uquchimiz, torta uzda paydogulgan mamalargi hitchimini topdi."
  },
  {
   "start": 151.24,
   "end": 158.18,
   "text": "Aga da sizxam, matijige elismakchi bulsangiz, ayazdan yitdiyarimda vangundan ortog olmakchi bulsangiz,"
  },
  {
   "start": 158.48,
   "end": 162.28,
   "text": "International School ga kilin, chunki International bu ayaz zavodi."
  },
  {
   "start": 162.72,
   "end": 163.14,
   "text": "Korshkunchi!"
  },
  {
   "start": 163.14,
   "end": 173.9,
   "text": "Abo la orkali, ru e hatdanuti."
  }
