  {
   "start": 0.0,
   "end": 3.86,
   "text": "International School ga kelganizda, sizda ikita masalayiz xal bolab."
  },
  {
   "start": 3.86,
   "end": 8.32,
   "text": "Birintisi, siz oz uslizdi ishlab nomorlarizgi yechim topaziz"
  },
  {
   "start": 8.32,
   "end": 10.7,
   "text": "va asosyisi natiji gerishijas."
  },
  {
   "start": 10.82,
   "end": 14.74,
   "text": "Bugun, tort toqquchumiz, tortta ayaz, tortta yetiyarim."
  },
  {
   "start": 15.3,
   "end": 18.94,
   "text": "Reading toqqas, listening toqqas, reading sakkizyarim,"
  },
  {
   "start": 19.06,
   "end": 20.86,
   "text": "vayanan bu bor, reading sakkizyarim."
  },
  {
   "start": 21.28,
   "end": 23.94,
   "text": "Kiliyle, okuchlarimizda, aynan International,"
  },
  {
   "start": 24.12,
   "end": 27.3,
   "text": "kanday momonu, yetiminu topganini bolibolab."
  },
  {
   "start": 27.74,
   "end": 29.1,
   "text": "Hello, what is your name?"
  },
  {
   "start": 29.1,
   "end": 34.18,
   "text": "Шахина, какая предложенка предложенка предложенка предложенка предложенка"
  },
  {
   "start": 34.18,
   "end": 35.98,
