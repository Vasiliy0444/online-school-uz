 "segments": [
  {
   "start": 0.0,
   "end": 2.56,
   "text": "Bugun sizlar bulan yana IELTS X haqida gaplashamiz."
  },
  {
   "start": 2.84,
   "end": 5.38,
   "text": "IELTS X-ne azalik domonlardan yana barashunda ki,"
  },
  {
   "start": 5.56,
   "end": 10.78,
   "text": "u dünyada ge en mazhkorva authentic, yani noyob bolgan IELTS materyalarini burca o'gecamlar,"
  },
  {
   "start": 11.1,
   "end": 15.98,
   "text": "ularinin kamçiglani doldurib, sizlarga takdim kilingan versiyasini korshingiz mumkun."
  },
  {
   "start": 16.36,
   "end": 21.56,
   "text": "Undan tashlar, IELTS X-nin mazhklari skill buildingla practice kusimlariga ajratilgat,"
  },
  {
   "start": 21.94,
   "end": 27.04,
   "text": "mingdan ortog turli, authentic, rasmimi malumotlar orqali tayorlangan bu testlar,"
  },
  {
   "start": 27.04,
   "end": 30.06,
   "text": "sizni natijagi bolgan yolingizni kafalatlaydi."
  },
  {
   "start": 30.56,
   "end": 32.32,
   "text": "Va ey muhami, xarbir seksyon,"
  },
  {
   "start": 32.4,
   "end": 34.8,
   "text": "yani listening, reading, writing, speaking boyche,"
  },
  {
   "start": 35.14,
   "end": 37.1,
   "text": "yoki aynan oshe seksyon boyche,"
  },
  {
   "start": 37.24,
   "end": 38.38,
   "text": "tok qizbao egyasi,"
  },
  {
   "start": 38.82,
   "end": 41.7,
   "text": "yoki bu masan native speaker tomondan daslat payarlaydi."
  },
  {
   "start": 41.82,
   "end": 43.22,
   "text": "Us bu videodarsliklardansiz,"
  },
  {
   "start": 43.28,
   "end": 46.32,
   "text": "24-ge 7 shakilda fodalanishiniz munkum boradi."
  },
  {
   "start": 46.76,
   "end": 49.26,
   "text": "Aynan siz xan yukari natijani kafalatli,"
  },
  {
   "start": 49.34,
   "end": 51.4,
   "text": "shun xaziroq international school-gi kelib,"
  },
  {
   "start": 51.7,
   "end": 54.54,
   "text": "ingilistili, yani ayalsini bizbila organi,"
  },
  {
   "start": 54.54,
   "end": 56.42,
   "text": "xavon orkali bizbila bolanishiniz munkum."
  },
  {
   "start": 57.04,
   "end": 59.72,
   "text": "Thank you for watching!"
  }
 ],
