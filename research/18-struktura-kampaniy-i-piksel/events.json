  "doc": "research/18-struktura-kampaniy-i-piksel/02-ТЗ-ПИКСЕЛЬ-CAPI.md",
  "pixel_id": "{{PIXEL_ID}}",
  "id_rules": {
    "vid": "постоянный ID посетителя: 16 знаков base36 (строчные латинские и цифры), localStorage + cookie 1 год",
    "sid": "ID визита: 12 знаков base36 (строчные латинские и цифры), sessionStorage; новый на каждый заход с меткой рекламы",
    "start_payload": "vm-<sid>-<ad_id> или vm-<sid>, если ad_id нет; не длиннее 64, только A-Z a-z 0-9 _ -",
    "external_id": "SHA-256 от строки ID; на лендинге [vid], в боте и дальше [vid, tg_id]",
    "fbc": "fb.1.<время первого появления fbclid в мс>.<fbclid как есть, регистр не менять>",
    "fbp": "cookie _fbp, которую ставит пиксель; передавать как есть",
    "event_time": "UTC, секунды; не старше 7 дней на момент отправки",
    "country": "SHA-256 от 'uz'"
  },
