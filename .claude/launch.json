{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "intensiv-designs",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "websites/intensiv-site"
      ],
      "port": 4173
    },
    {
      "name": "intensiv-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "websites/intensiv-site",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "intensiv-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "websites/intensiv-site",
        "run",
        "preview"
      ],
      "port": 4174,
      "url": "http://localhost:4174"
    }
  ]
}